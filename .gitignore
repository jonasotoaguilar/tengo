# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Keep project skill provenance even when a global ignore excludes it.
!/skills-lock.json
.agents/

# Lefthook local overrides (per-machine hook tweaks; see lefthook.yml).
/lefthook-local.yml
/skills-lock.json
