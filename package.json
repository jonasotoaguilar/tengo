{
  "name": "tengo",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node -e \"console.error('Web is not installed: this project ships native Android/iOS only.');process.exit(1)\"",
    "test": "jest",
    "test:ci": "jest --ci --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "compat": "expo install --check",
    "export:smoke": "expo export --platform android --output-dir dist/ci-export",
    "prepare": "lefthook install"
  },
  "engines": {
    "node": "26.x",
    "npm": ">=11"
  },
  "dependencies": {
    "expo": "~57.0.26",
    "expo-localization": "~57.0.2",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "lefthook": "^2.1.17",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  }
}
